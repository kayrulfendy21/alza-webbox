<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alza WebBox (StreamAuto Edition)"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Paste any video or streaming URL below to send it straight to your Perodua Alza AV screen (or use Share -> Alza WebBox inside the YouTube app):"
        android:textColor="#B3B3B3"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editDefaultUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="https://m.youtube.com"
        android:inputType="textUri"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777" />

    <Button
        android:id="@+id/btnSaveUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Play on Car Now / Save URL" />

</LinearLayout>
