<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alza WebBox (StreamAuto Edition)"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtInstallStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:background="#1E1E1E"
        android:text="Checking installer status..."
        android:textColor="#81C784"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSelfInstall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2E7D32"
        android:text="1. Activate for Android Auto (Self-Install)"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Default Homepage / Cast URL to Car Screen:"
        android:textColor="#B3B3B3"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editDefaultUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="https://m.youtube.com"
        android:inputType="textUri"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777" />

    <Button
        android:id="@+id/btnSaveUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Play on Car Now / Save URL" />

</LinearLayout>
