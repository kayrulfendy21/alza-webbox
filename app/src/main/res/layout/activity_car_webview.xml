<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000">

    <ScrollView
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="#181818">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnKeyboard"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#2E7D32"
                android:text="KB"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:text="Back"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnReload"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:text="Reload"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnYT"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="YouTube"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnViu"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:text="Viu"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnIqiyi"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:text="iQiyi"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnNetflix"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:text="Netflix"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnMode"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="Mobile"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnAdBlock"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:text="AdBlk:ON"
                android:textSize="9sp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <WebView
            android:id="@+id/carWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/keyboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#202124"
            android:padding="4dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
